# 复制为 .env 后填写。真实密钥只放服务器环境变量或密钥管理，不要提交、不要发到聊天里。
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://app:app_dev_only@localhost:5432/ecomfin?schema=public
# 至少 16 位随机字符串；生产用密钥管理注入
JWT_SECRET=
JWT_EXPIRES_IN=8h
# 通知里“查看完整报表”的链接
PUBLIC_BASE_URL=http://localhost:3000

# 种子账号密码（仅本地/测试；生产禁止使用种子）
SEED_OWNER_PASSWORD=
SEED_FINANCE_PASSWORD=
SEED_VIEWER_PASSWORD=

# ---------- 模型（客户公司自选国内模型） ----------
# mock | deepseek | qwen | moonshot | zhipu | doubao | openai_compatible
MODEL_PROVIDER=mock
MODEL_BASE_URL=
MODEL_NAME=
MODEL_API_KEY=
# 元 / 千 tokens，用于成本计量（按合同价填写）
MODEL_PRICE_INPUT_PER_1K=
MODEL_PRICE_OUTPUT_PER_1K=
MODEL_TIMEOUT_MS=60000

# ---------- 办公平台连接器 ----------
# mock（默认，不对外发送）| dingtalk | feishu（未实现）| wecom（未实现）
CONNECTOR_PROVIDER=mock
NOTIFY_ROLES=OWNER,FINANCE
# 钉钉：robot（群机器人）| work_notice（工作通知）
DINGTALK_NOTIFY_CHANNEL=robot
DINGTALK_ROBOT_ACCESS_TOKEN=
DINGTALK_ROBOT_SECRET=
DINGTALK_APP_KEY=
DINGTALK_APP_SECRET=
DINGTALK_AGENT_ID=
# 钉钉工作台 H5 微应用免登需要（企业 CorpId，非密钥）；首页地址填 https://你的域名/?tenant=企业代码
DINGTALK_CORP_ID=

# 数据源（钉钉 AI 表格 / 知识库 → 工作台）定时同步：on | off（测试环境自动关闭）
# 读钉钉数据复用上面的 DINGTALK_APP_KEY / DINGTALK_APP_SECRET，需在钉钉后台额外开通 AI 表格、知识库读权限
SOURCE_SYNC_SCHEDULER=on
